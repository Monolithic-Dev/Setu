# =============================================================================
# Setu Intelligence Platform — .gitignore
# =============================================================================

# ──────────────────────────────────────
# Environment & Secrets
# ──────────────────────────────────────
.env
*.env
!.env.example

# ──────────────────────────────────────
# Python
# ──────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
venv/
.venv/
env/
*.egg-info/
.eggs/
dist/
build/
*.dist-info/
htmlcov/
coverage/
.coverage
.coverage.*
*.cover

# ──────────────────────────────────────
# Node / Frontend
# ──────────────────────────────────────
node_modules/
client/dist/
client/build/
client/.pnpm-store/
client/node_modules/.cache/
*.tsbuildinfo

# ──────────────────────────────────────
# Zoho Catalyst
# ──────────────────────────────────────
.catalystrc
.catalyst-cache/
catalyst-debug.log
.build/

# ──────────────────────────────────────
# Data — generated files (not committed)
# Only the bundled synthetic data for the function is committed.
# ──────────────────────────────────────
**/data/*.csv
**/data/csv_exports/
data/

!functions/setu_api/data/*.json

# ──────────────────────────────────────
# Dev & Scratch Artifacts
# ──────────────────────────────────────
*_results.json
tree_output.txt
*.log
scratch/
PHASE8_STATUS.md
uv.lock

# ──────────────────────────────────────
# OS
# ──────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ──────────────────────────────────────
# IDE & Editor
# ──────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.sublime-workspace

# ──────────────────────────────────────
# AI Agents & Tools
# ──────────────────────────────────────
.gemini/
.agents/

