# Copy this file to .env in each function directory that needs it, and fill in real values.
# Catalyst-native services (Data Store, QuickML, Cache, Authentication, Stratus) are
# configured through the Catalyst console/CLI, not environment variables — see
# docs/DeploymentStrategy.md §3.

# Indic speech providers (functions/shared/speech_adapter.py)
BHASHINI_API_KEY=
BHASHINI_ENDPOINT=

SARVAM_API_KEY=
SARVAM_ENDPOINT=

# Set once Catalyst QuickML early access is granted (RiskRegister R1) —
# needed by functions/shared/retrieval/semantic_search.py
QUICKML_KNOWLEDGE_BASE_ID=
